# Variables gestionadas por Lovable Cloud — este archivo solo documenta los nombres.
# No copies secretos reales aquí; en Lovable se configuran desde el panel.

# Navegador (públicas, las inyecta Lovable automáticamente)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=tu-proyecto

# Servidor (solo en el worker; nunca con prefijo VITE_)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
SUPABASE_PROJECT_ID=tu-proyecto

# Autenticación: correo/contraseña y Google están activados en Lovable Cloud.
# No se necesitan claves de terceros: el inicio con Google usa las credenciales
# gestionadas por Lovable. Las cuentas de contraseña usan correos internos
# sintéticos <usuario>@nizeta.local y no reciben correo real.
